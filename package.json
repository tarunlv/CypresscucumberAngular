{
  "name": "angular-base",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:unit": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "cypress:install": "cypress install",
    "e2e": "npm run e2e:run",
    "e2e:open": "cypress open",
    "e2e:run": "start-server-and-test \"npm run start -- --port 4300 --watch=false\" http://localhost:4300 cypress:run",
    "cypress:run": "cypress run --browser chrome"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@vitest/coverage-v8": "^4.1.11",
    "cypress": "^16.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/**/*.steps.ts",
      "cypress/support/step_definitions/**/*.ts"
    ]
  }
}
